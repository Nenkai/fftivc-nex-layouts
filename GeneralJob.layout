table_name|GeneralJob
set_table_type|SingleKeyed
set_table_category|SingleKeyed
use_base_row_id|true

// All 21 rows are largely hardcoded - ref: 0F 8C ? ? ? ? 31 C0
// Main ref: E8 ? ? ? ? 48 8B F8 48 85 C0 0F 84 ? ? ? ? B9

add_column|DLCFlags|int
add_column|Comment|string

// JP breakpoints for job levels 1-9.
// 9-element array, identical across all 20 jobs: [0, 100, 200, 400, 700, 1100, 1600, 2200, 3000].
// Empty for Dark Knight. Values are shorts stored as ints.
add_column|JobLevelThresholds|int[]   // 08 - JP breakpoints for levels 1-9. identical across all jobs
add_column|RequiredJobIds|int[]       // 10 - ref: 0F 4C 48 ? 45 33 D2
add_column|RequiredJobLevels|short[]  // 18 - ref: 66 44 39 14 38


// Per-prerequisite edge type enum (1-6). Parallel array with RequiredJobIds.
// Controls label direction (1=Left, 2=Right, 3/5/6=Bottom, 4=Top) and line element naming.
// Values 1-4 look up paired lines: Line{target}{prereq} e.g. "LineSamuraiKnight"
// Values 5-6 look up forking lines: Line{prereq}Lv{level} e.g. "LineSquireLv02"
// Forking lines are shared — Squire's single fork serves both Knight and Archer.
// 5 and 6 are functionally identical; only used for starter-tier connections.
add_column|RequiredJobConnectionTypes|int[]  // 20 - edge type enum (1-6) per prerequisite


// Cursor navigation targets for the Enhanced job tree UI.
// 8 directions: 0=Right, 1=DownRight, 2=Down, 3=DownLeft, 4=Left, 5=UpLeft, 6=Up, 7=UpRight.
// Value 20 = sentinel (no neighbor). Tree wraps both horizontally and vertically.

add_column|NavRightTarget|int      // 28 - job ID reached by pressing Right. 0-20, 20=no neighbor
add_column|NavDownRightTarget|int  // 2C
add_column|NavDownTarget|int       // 30
add_column|NavDownLeftTarget|int   // 34
add_column|NavLeftTarget|int       // 38
add_column|NavUpLeftTarget|int     // 3C
add_column|NavUpTarget|int         // 40
add_column|NavUpRightTarget|int    // 44

// Gender-swap fallback targets. When a gender-locked job is hidden
// (Bard=male-only, Dancer=female-only), NavTargetAlt provides the replacement.
// 20 = same target for both genders. Only 8 of 168 slots are non-sentinel.

add_column|NavRightTargetAlt|int      // 48
add_column|NavDownRightTargetAlt|int  // 4C
add_column|NavDownTargetAlt|int       // 50
add_column|NavDownLeftTargetAlt|int   // 54
add_column|NavLeftTargetAlt|int       // 58
add_column|NavUpLeftTargetAlt|int     // 5C
add_column|NavUpTargetAlt|int         // 60
add_column|NavUpRightTargetAlt|int    // 64

// Coordinate frame selector per direction. 0=standard, 1=mirrored (1920-base).
// Set to 1 when the connection crosses the tree's center axis.

add_column|NavRightIsMirrored|byte      // 68
add_column|NavDownRightIsMirrored|byte  // 69
add_column|NavDownIsMirrored|byte       // 6A
add_column|NavDownLeftIsMirrored|byte   // 6B
add_column|NavLeftIsMirrored|byte       // 6C
add_column|NavUpLeftIsMirrored|byte     // 6D
add_column|NavUpIsMirrored|byte         // 6E
add_column|NavUpRightIsMirrored|byte    // 6F

// Per-direction byte, always 0. Written by interleaved copy loop but never read back.

add_column|NavRightUnused|byte      // 70
add_column|NavDownRightUnused|byte  // 71
add_column|NavDownUnused|byte       // 72
add_column|NavDownLeftUnused|byte   // 73
add_column|NavLeftUnused|byte       // 74
add_column|NavUpLeftUnused|byte     // 75
add_column|NavUpUnused|byte         // 76
add_column|NavUpRightUnused|byte    // 77

add_column|RequiresUnlock|byte    // 78 - 0=starter job (Squire/Chemist), 1=must be unlocked

// Struct alignment padding. Record size = 0x7C (124 bytes).

add_column|Padding79|byte  // 79 - always 0
add_column|Padding7A|byte  // 7A - always 0
add_column|Padding7B|byte  // 7B - always 0
